{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "src/verify-project.ts",
    "src/test-phase2.ts",
    "src/ingest-documents.ts",
    "src/preflight.ts",
    "src/scripts/reindex-pinecone.ts",
    "src/scripts/diagnose.ts"
  ]
}
