# ─── StockAI Server — Environment Variables Reference ─────────────────────────
# Copy this to .env and fill in your real values.
# NEVER commit .env to version control.

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Supabase ────────────────────────────────────────────────────────────────
# Used for: document metadata, file storage, chats, messages, auth
# NOT used for vector storage (that's Pinecone)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Pinecone (Vector Database) ───────────────────────────────────────────────
# Sign up at: https://app.pinecone.io (free tier available)
# Create index with these settings:
#   Name:       stockai-documents  (match PINECONE_INDEX_NAME below)
#   Dimensions: 384                (required for BAAI/bge-small-en-v1.5)
#   Metric:     cosine
#   Cloud:      aws
#   Region:     us-east-1          (or your preferred region)
PINECONE_API_KEY=pc-your-pinecone-api-key
PINECONE_INDEX_NAME=stockai-documents
PINECONE_REGION=us-east-1

# ─── Groq LLM ────────────────────────────────────────────────────────────────
# https://console.groq.com/keys (free)
# Models: llama-3.3-70b-versatile | llama-3.1-8b-instant | mixtral-8x7b-32768
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# ─── HuggingFace Embeddings ───────────────────────────────────────────────────
# https://huggingface.co/settings/tokens (free read token)
# BAAI/bge-small-en-v1.5 → 384 dimensions (must match Pinecone index dimension)
HUGGINGFACE_API_KEY=hf_your_token
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ─── External APIs ────────────────────────────────────────────────────────────
ALPHA_VANTAGE_KEY=your-key
NEWS_API_KEY=your-key

# ─── CORS ────────────────────────────────────────────────────────────────────
# NO trailing slashes
ALLOWED_ORIGIN=https://your-app.vercel.app
CLOUDFLARE_TUNNEL_ORIGIN=
ALLOWED_ORIGINS_EXTRA=
